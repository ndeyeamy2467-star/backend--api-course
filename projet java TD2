import java.util.Random;

public class Tamagotchi {

    // Les attributs privés
    private int age;
    private int dureeDeVie;
    private int maxEnergie;
    private int energie;
    private String nom;

    // Constructeur
    public Tamagotchi(String nom) {

        Random hasard = new Random();

        this.nom = nom;
        this.age = 0;
        this.dureeDeVie = hasard.nextInt(6) + 9;
        this.maxEnergie = hasard.nextInt(5) + 5;
        this.energie = hasard.nextInt(maxEnergie - 2) + 3;
    }

    // Methode parler
    public void parler() {

        if (energie > 5) {
            System.out.println(nom + " : tout va bien !");
        } else {
            System.out.println(nom + " : je suis affame !");
        }
    }

    // Methode manger
    public void manger() {

        if (energie >= maxEnergie) {
            System.out.println(nom + " : je n'ai pas faim !!");
        } else {

            Random hasard = new Random();
            int nourriture = hasard.nextInt(3) + 1;

            energie = energie + nourriture;

            if (energie > maxEnergie) {
                energie = maxEnergie;
            }

            System.out.println(nom + " : Merci !");
        }
    }

    // Tester si le Tamagotchi a atteint son age limite
    public boolean ageLimite() {
        return age >= dureeDeVie;
    }

    // Methode vivre
    public boolean vivre() {

        if (ageLimite()) {
            return true;
        }

        if (energie <= 0) {
            System.out.println(nom + " : je meurs... Arrrggh !");
            return false;
        }

        age++;
        energie--;

        if (ageLimite()) {
            System.out.println(nom + " : c'est gagne pour moi !");
        } else {
            parler();
        }

        return true;
    }

    // Getter pour le nom
    public String getNom() {
        return nom;
    }

    // Getter pour verifier l'age limite
    public boolean estTermine() {
        return ageLimite();
    }
}
